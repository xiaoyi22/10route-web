[Unit]
Description=10Router Web auto publish from Windows share
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/meet/10router-web
ExecStart=/usr/bin/bash /home/meet/10router-web/scripts/publish-watch.sh --quiet
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target