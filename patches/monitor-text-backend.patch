diff --git a/tests/unit/monitor-sse-nonstream.test.js b/tests/unit/monitor-sse-nonstream.test.js
new file mode 100644
index 0000000..b5ccac9
--- /dev/null
+++ b/tests/unit/monitor-sse-nonstream.test.js
@@ -0,0 +1,59 @@
+import { describe, it, expect, vi } from "vitest";
+
+const { execute } = vi.hoisted(() => ({ execute: vi.fn() }));
+vi.mock("../../open-sse/executors/index.js", () => ({ getExecutor: () => ({ noAuth: true, execute }) }));
+vi.mock("../../open-sse/utils/requestLogger.js", () => ({ createRequestLogger: async () => ({
+  logClientRawRequest() {}, logRawRequest() {}, logTargetRequest() {}, logProviderResponse() {}, logConvertedResponse() {}, logError() {},
+}) }));
+vi.mock("@/lib/usageDb.js", () => ({
+  trackPendingRequest: vi.fn(), appendRequestLog: vi.fn(async () => {}), saveRequestDetail: vi.fn(async () => {}), saveRequestUsage: vi.fn(async () => {}),
+}));
+import "../../open-sse/index.js";
+import { handleChatCore } from "../../open-sse/handlers/chatCore.js";
+
+describe("non-stream monitor receiving upstream SSE", () => {
+  it("uses the monitor executor that enforces its deadline", async () => {
+    const abort = new AbortController();
+    abort.abort();
+    const limited = vi.fn(async options => {
+      expect(options.signal.aborted).toBe(true);
+      throw new DOMException("Monitor deadline aborted", "AbortError");
+    });
+    execute.mockClear();
+    const result = await handleChatCore({
+      body: { model: "gpt-4o", stream: false, messages: [{ role: "user", content: "puzzle" }] },
+      modelInfo: { provider: "openai", model: "gpt-4o" }, credentials: { apiKey: "test" },
+      _executorOverride: { execute: options => limited({ ...options, signal: AbortSignal.any([options.signal, abort.signal]) }) },
+    });
+    expect(limited).toHaveBeenCalledOnce();
+    expect(limited.mock.calls[0][0].signal.aborted).toBe(true);
+    expect(execute).not.toHaveBeenCalled();
+    expect(result.success).toBe(false);
+  });
+  for (const sourceFormat of ["openai", "openai-responses"]) {
+    it(`retains Responses final text for a ${sourceFormat} client`, async () => {
+      const response = { id: "resp_monitor", object: "response", status: "completed", model: "gpt-6.1-sol", output: [
+        { type: "reasoning", summary: [] },
+        { type: "message", role: "assistant", status: "completed", content: [{ type: "output_text", text: "IQ-ANSWER: 21" }] },
+      ], usage: { input_tokens: 209, output_tokens: 599, total_tokens: 808 } };
+      const events = [
+        { type: "response.created", response: { ...response, status: "in_progress", output: [] } },
+        ...response.output.map((item, output_index) => ({ type: "response.output_item.done", item, output_index })),
+        { type: "response.completed", response },
+      ];
+      const raw = ': keepalive\n\n' + events.map(event => 'event: ' + event.type + '\ndata: ' + JSON.stringify(event) + '\n\n').join('');
+      execute.mockResolvedValue({ response: new Response(raw, { headers: { "content-type": "text/event-stream" } }), headers: {}, url: "https://example.test/v1/responses" });
+      const result = await handleChatCore({
+        body: { model: "gpt-6.1-sol(high)", stream: false, ...(sourceFormat === "openai" ? { messages: [{ role: "user", content: "puzzle" }] } : { input: "puzzle" }) },
+        modelInfo: { provider: "openai-compatible-chat-monitor", model: "gpt-6.1-sol(high)" },
+        credentials: { apiKey: "test", providerSpecificData: { apiType: "responses" } },
+        sourceFormatOverride: sourceFormat, connectionId: "test", rtkEnabled: false,
+      });
+      expect(result.success).toBe(true);
+      const parsed = await result.response.json();
+      const content = sourceFormat === "openai" ? parsed.choices[0].message.content : parsed.output.find(item => item.type === "message")?.content[0].text;
+      expect(content).toBe("IQ-ANSWER: 21");
+      expect(sourceFormat === "openai" ? parsed.usage.completion_tokens : parsed.usage.output_tokens).toBe(599);
+    });
+  }
+});
