diff --git a/tests/unit/combo-sticky-settings.test.js b/tests/unit/combo-sticky-settings.test.js
new file mode 100644
--- /dev/null
+++ b/tests/unit/combo-sticky-settings.test.js
@@ -0,0 +1,40 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+const mocks = vi.hoisted(() => ({ update: vi.fn(), reset: vi.fn() }));
+vi.mock("@/lib/localDb", () => ({ getSettings: async () => ({}), updateSettings: mocks.update }));
+vi.mock("open-sse/services/combo.js", () => ({ resetComboRotation: mocks.reset }));
+import { PATCH } from "../../src/app/api/settings/route.js";
+const request = body => new Request("http://localhost/api/settings", { method: "PATCH", body: JSON.stringify(body) });
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.update.mockImplementation(async body => body);
+});
+describe("per-combo sticky settings", () => {
+  it.each([0, -1, 1.5, "9", null, true, 9007199254740992])("rejects invalid count %s before updating settings", async value => {
+    for (const body of [{ comboStickyRoundRobinLimit: value }, { comboStrategies: { code: { comboStickyRoundRobinLimit: value } } }]) {
+      const response = await PATCH(request(body));
+      expect(response.status).toBe(400);
+      expect((await response.json()).code).toBe("COMBO_STICKY_LIMIT_INVALID");
+    }
+    expect(mocks.update).not.toHaveBeenCalled();
+    expect(mocks.reset).not.toHaveBeenCalled();
+  });
+  it.each([null, [], 9, { code: null }, { code: [] }])("rejects malformed strategy map %s", async comboStrategies => {
+    expect((await PATCH(request({ comboStrategies }))).status).toBe(400);
+    expect(mocks.update).not.toHaveBeenCalled();
+  });
+  it("preserves independent overrides and other fields, and resets rotation", async () => {
+    const body = { comboStrategies: { code: { fallbackStrategy: "round-robin", comboStickyRoundRobinLimit: 9, retryOnEmpty: true }, standby: { fallbackStrategy: "fallback", comboStickyRoundRobinLimit: 3 }, inherited: {}, fusion: { fallbackStrategy: "fusion", judgeModel: "p/judge" } } };
+    const response = await PATCH(request(body));
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject(body);
+    expect(mocks.update).toHaveBeenCalledWith(body);
+    expect(mocks.reset).toHaveBeenCalledTimes(1);
+  });
+  it("accepts removal of overrides to inherit and leaves unrelated changes alone", async () => {
+    expect((await PATCH(request({ comboStrategies: {} }))).status).toBe(200);
+    expect(mocks.reset).toHaveBeenCalledTimes(1);
+    mocks.reset.mockClear();
+    expect((await PATCH(request({ theme: "dark" }))).status).toBe(200);
+    expect(mocks.reset).not.toHaveBeenCalled();
+  });
+});
diff --git a/tests/unit/combo-sticky-handlers.test.js b/tests/unit/combo-sticky-handlers.test.js
new file mode 100644
--- /dev/null
+++ b/tests/unit/combo-sticky-handlers.test.js
@@ -0,0 +1,56 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+const mocks = vi.hoisted(() => ({ settings: {}, combo: vi.fn(), getModels: vi.fn() }));
+vi.mock("open-sse/index.js", () => ({}));
+vi.mock("@/lib/localDb", () => ({
+  getSettings: async () => mocks.settings,
+  getCombos: async () => [{ name: "code", models: ["p/a", "p/b"] }],
+  getChannelBlock: vi.fn(), setChannelBlock: vi.fn(), clearChannelBlock: vi.fn(),
+}));
+vi.mock("../../src/sse/services/auth.js", () => ({
+  extractApiKey: () => null, isValidApiKey: async () => true, checkApiKeyDailyLimit: async () => null,
+  getProviderCredentials: vi.fn(), markAccountUnavailable: vi.fn(), clearAccountError: vi.fn(), invalidateQuotaCache: vi.fn(),
+}));
+vi.mock("../../src/sse/services/model.js", () => ({
+  getModelInfo: async () => ({}), getComboModels: mocks.getModels,
+}));
+vi.mock("../../src/sse/services/autoCompact.js", () => ({ maybeCompactChatBody: async () => {} }));
+vi.mock("open-sse/services/combo.js", async importOriginal => ({
+  ...await importOriginal(), handleComboChat: mocks.combo,
+}));
+import { handleChat } from "../../src/sse/handlers/chat.js";
+import { handleImageGeneration } from "../../src/sse/handlers/imageGeneration.js";
+import { handleTts } from "../../src/sse/handlers/tts.js";
+import { handleSearch } from "../../src/sse/handlers/search.js";
+import { handleFetch } from "../../src/sse/handlers/fetch.js";
+const entries = [handleChat, handleImageGeneration, handleTts, handleSearch, handleFetch];
+const request = () => new Request("http://localhost/api/v1/test", { method: "POST", body: JSON.stringify({ model: "code", prompt: "OK", input: "OK", query: "OK", url: "https://example.com", messages: [{ role: "user", content: "OK" }] }) });
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.settings = { comboStrategy: "round-robin", comboStickyRoundRobinLimit: 3, stickyRoundRobinLimit: 77, comboStrategies: { code: { comboStickyRoundRobinLimit: 9 }, other: { comboStickyRoundRobinLimit: 5 } } };
+  mocks.getModels.mockResolvedValue(["p/a", "p/b"]);
+  mocks.combo.mockResolvedValue(new Response("OK"));
+});
+describe("per-combo sticky entry points", () => {
+  it.each(entries)("uses only this combo override in %s", async handler => {
+    await handler(request());
+    expect(mocks.combo).toHaveBeenCalledWith(expect.objectContaining({ comboName: "code", comboStrategy: "round-robin", comboStickyLimit: 9 }));
+  });
+  it.each(entries)("inherits the global count in %s", async handler => {
+    delete mocks.settings.comboStrategies.code.comboStickyRoundRobinLimit;
+    await handler(request());
+    expect(mocks.combo).toHaveBeenCalledWith(expect.objectContaining({ comboStickyLimit: 3 }));
+  });
+  it.each(entries)("defaults to one when both settings are absent in %s", async handler => {
+    delete mocks.settings.comboStrategies.code.comboStickyRoundRobinLimit;
+    delete mocks.settings.comboStickyRoundRobinLimit;
+    await handler(request());
+    expect(mocks.combo).toHaveBeenCalledWith(expect.objectContaining({ comboStickyLimit: 1 }));
+  });
+  it("also uses the override in the nested chat combo dispatch", async () => {
+    await handleChat(request());
+    const outer = mocks.combo.mock.calls[0][0];
+    await outer.handleSingleModel({ model: "code", messages: [{ role: "user", content: "OK" }] }, "code");
+    expect(mocks.combo).toHaveBeenCalledTimes(2);
+    expect(mocks.combo.mock.calls[1][0]).toMatchObject({ comboName: "code", comboStickyLimit: 9 });
+  });
+});
diff --git a/tests/unit/combo-sticky-nine.test.js b/tests/unit/combo-sticky-nine.test.js
new file mode 100644
--- /dev/null
+++ b/tests/unit/combo-sticky-nine.test.js
@@ -0,0 +1,12 @@
+import { beforeEach, expect, it } from "vitest";
+import { getRotatedModels, resetComboRotation } from "../../open-sse/services/combo.js";
+beforeEach(resetComboRotation);
+it("keeps each member first for nine requests and rotates independently", () => {
+  const models = ["p/a", "p/b"];
+  const selected = Array.from({ length: 19 }, () => getRotatedModels(models, "code", "round-robin", 9)[0]);
+  expect(selected).toEqual([...Array(9).fill("p/a"), ...Array(9).fill("p/b"), "p/a"]);
+  expect(getRotatedModels(models, "other", "round-robin", 3)[0]).toBe("p/a");
+  expect(getRotatedModels(models, "primary", "fallback", 9)).toEqual(models);
+  resetComboRotation();
+  expect(getRotatedModels(models, "code", "round-robin", 9)[0]).toBe("p/a");
+});
