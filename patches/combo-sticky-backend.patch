diff --git a/src/app/api/settings/route.js b/src/app/api/settings/route.js
index 59abef4..52abd81 100644
--- a/src/app/api/settings/route.js
+++ b/src/app/api/settings/route.js
@@ -42,6 +42,30 @@ export async function PATCH(request) {
   try {
     const body = await request.json();
 
+    const validComboStickyLimit = value => Number.isSafeInteger(value) && value >= 1;
+    if (
+      Object.prototype.hasOwnProperty.call(body, "comboStickyRoundRobinLimit") &&
+      !validComboStickyLimit(body.comboStickyRoundRobinLimit)
+    ) {
+      return NextResponse.json({ error: "Combo sticky limit must be a positive integer", code: "COMBO_STICKY_LIMIT_INVALID" }, { status: 400 });
+    }
+    if (Object.prototype.hasOwnProperty.call(body, "comboStrategies")) {
+      if (!body.comboStrategies || typeof body.comboStrategies !== "object" || Array.isArray(body.comboStrategies)) {
+        return NextResponse.json({ error: "Combo strategies must be an object", code: "COMBO_STRATEGIES_INVALID" }, { status: 400 });
+      }
+      for (const override of Object.values(body.comboStrategies)) {
+        if (!override || typeof override !== "object" || Array.isArray(override)) {
+          return NextResponse.json({ error: "Combo strategy must be an object", code: "COMBO_STRATEGIES_INVALID" }, { status: 400 });
+        }
+        if (
+          Object.prototype.hasOwnProperty.call(override, "comboStickyRoundRobinLimit") &&
+          !validComboStickyLimit(override.comboStickyRoundRobinLimit)
+        ) {
+          return NextResponse.json({ error: "Combo sticky limit must be a positive integer", code: "COMBO_STICKY_LIMIT_INVALID" }, { status: 400 });
+        }
+      }
+    }
+
     // Strip protected secrets before any internal handling sets them
     for (const key of PROTECTED_SETTING_KEYS) delete body[key];
 
