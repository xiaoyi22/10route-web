@@ -0,0 +1,42 @@
+import { it, expect } from "vitest";
+import { createServer } from "node:http";
+import { writeFile } from "node:fs/promises";
+
+it.skipIf(process.env.TENROUTER_RUN_MONITOR_LIVE !== "1")("checks high thinking on the real provider and retains history over HTTP", async () => {
+  delete process.env.ALL_PROXY;
+  const { POST } = await import("../../src/app/api/models/test/route.js");
+  const { GET } = await import("../../src/app/api/iq-monitor/route.js");
+  const { getConfig, getCatalog } = await import("../../src/lib/iqMonitor/service.js");
+  const { getProviderNodes } = await import("../../src/lib/localDb.js");
+  const [config, catalog, nodes] = await Promise.all([getConfig(), getCatalog(), getProviderNodes()]);
+  const node = nodes.find(node => node.prefix === "nexa");
+  expect(node).toBeTruthy();
+  const target = { provider: node.id, model: "gpt-6.1-sol" };
+  expect(catalog.find(provider => provider.id === node.id)?.models).toContain(target.model);
+  const server = createServer(async (req, res) => {
+    let body = ""; for await (const chunk of req) body += chunk;
+    const request = new Request("http://127.0.0.1" + req.url, { method: req.method, ...(body && { body, headers: { "content-type": "application/json" } }) });
+    try {
+      const response = req.method === "POST" ? await POST(request) : await GET();
+      res.writeHead(response.status, Object.fromEntries(response.headers)); res.end(await response.text());
+    } catch (error) { res.writeHead(500); res.end(JSON.stringify({ error: error.message })); }
+  });
+  await new Promise(resolve => server.listen(0, "127.0.0.1", resolve));
+  const base = "http://127.0.0.1:" + server.address().port;
+  const report = { model: "nexa/gpt-6.1-sol", thinkingLevel: "high", data: "isolated snapshot of real gateway", assertions: [] };
+  try {
+    const response = await fetch(base + "/api/models/test", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ model: report.model, kind: "llm", probe: "iq", thinkingLevel: "high", monitorTarget: target }) });
+    report.http = response.status; report.result = await response.json();
+    expect(response.status).toBe(200);
+    expect(report.result.error || "").not.toContain("restricted model list");
+    expect(report.result.monitorRow).toMatchObject({ ...target, thinkingLevel: "high", persisted: true, manual: true });
+    const snapshot = await (await fetch(base + "/api/iq-monitor")).json();
+    expect(snapshot.state.history).toContainEqual(report.result.monitorRow);
+    expect(await getConfig()).toEqual(config);
+    report.assertions.push("HTTP 200; high thinking bypasses model-name allowlist mismatch; history persists; schedule unchanged");
+    console.log(JSON.stringify({ http: report.http, ok: report.result.ok, status: report.result.monitorRow.status, latencyMs: report.result.latencyMs, error: report.result.error, assertions: report.assertions }));
+  } finally {
+    await writeFile("/home/meet/.codex/tmp/monitor-manual-20261014/live-result.json", JSON.stringify(report, null, 2));
+    await new Promise(resolve => server.close(resolve));
+  }
+}, 90000);
