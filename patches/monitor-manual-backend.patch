diff --git a/tests/unit/iq-probe.test.js b/tests/unit/iq-probe.test.js
new file mode 100644
index 00000000..8bea5237
--- /dev/null
+++ b/tests/unit/iq-probe.test.js
@@ -0,0 +1,188 @@
+// IQ probe: the operator-configured puzzle (settings.iqProbe) sent to one
+// model at a time and graded server-side.
+//
+// Two things these tests are here to hold down:
+//   * the grader reads the FIRST number in the reply, not the last. A model
+//     that reasons "…so at least 23, the answer is 23" is right, and so is one
+//     that never restates the number at the end. Scanning from the end instead
+//     flips correct answers to wrong whenever the closing sentence happens to
+//     carry a different number ("需要 23 个" vs "最多 41 个").
+//   * a wrong answer is a SUCCESSFUL probe with `correct:false` — never an
+//     error. If it came back ok:false the row would show a red connection
+//     failure and the operator would go debug an account that is fine.
+
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+
+vi.mock("@/lib/localDb", () => ({
+  getApiKeys: vi.fn(async () => [{ key: "test-key", isActive: true }]),
+  getSettings: vi.fn(async () => ({})),
+}));
+vi.mock("@/shared/constants/config", () => ({ UPDATER_CONFIG: { appPort: 20127 } }));
+vi.mock("@/shared/utils/machineId", () => ({ getConsistentMachineId: vi.fn(async () => "cli-token") }));
+
+const { pingIqModel } = await import("../../src/app/api/models/test/ping.js");
+const { mergeWithDefaults } = await import("../../src/lib/db/repos/settingsRepo.js");
+
+const CANDY_QUESTION = "最少取出多少个糖果…";
+const CANDY_ANSWER = "23";
+
+describe("pingIqModel", () => {
+  let fetchMock;
+
+  beforeEach(() => {
+    fetchMock = vi.fn();
+    vi.stubGlobal("fetch", fetchMock);
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  function reply(content) {
+    return {
+      ok: true,
+      status: 200,
+      text: async () => JSON.stringify({ choices: [{ message: { content } }] }),
+    };
+  }
+
+  const run = (content) => {
+    fetchMock.mockResolvedValue(reply(content));
+    return pingIqModel("openai/gpt-4o", CANDY_QUESTION, CANDY_ANSWER, "http://127.0.0.1:20127");
+  };
+
+  it("sends the configured question, not a fixed ping", async () => {
+    await run("23");
+
+    const body = JSON.parse(fetchMock.mock.calls[0][1].body);
+    expect(body.messages[0].content).toBe(CANDY_QUESTION);
+    expect(body.stream).toBe(false);
+    // Reasoning models burn the budget before answering — same 1024 as the
+    // liveness probe.
+    expect(body.max_tokens).toBe(1024);
+  });
+
+  it("passes a model that answers the expected number", async () => {
+    const result = await run("23");
+    expect(result.ok).toBe(true);
+    expect(result.error).toBeNull();
+    expect(result.iq.correct).toBe(true);
+    expect(result.iq.modelAnswered).toBe("23");
+    expect(result.iq.expected).toBe("23");
+  });
+
+  it("reads the concluding number, not the arithmetic on the way there", async () => {
+    const result = await run("7+6+4=17，所以最少 23 个。");
+    expect(result.iq.modelAnswered).toBe("23");
+    expect(result.iq.correct).toBe(true);
+  });
+
+  it("honours an explicit IQ-ANSWER marker over the trailing text", async () => {
+    const result = await run("最少 23 个，若只按形状算则 18 个。\nIQ-ANSWER: 23");
+    expect(result.iq.modelAnswered).toBe("23");
+    expect(result.iq.correct).toBe(true);
+  });
+
+  it("marker wins even when the reply ends on a different number", async () => {
+    const result = await run("IQ-ANSWER: 23\n（最多需要 41 个）");
+    expect(result.iq.modelAnswered).toBe("23");
+    expect(result.iq.correct).toBe(true);
+  });
+
+  it("does not grade the verification number of an answer-first reply", async () => {
+    // The shape that forced the marker: answer up front, then the counter-
+    // example. A positional read (last number = 22) marks this correct answer
+    // wrong.
+    const result = await run("答案是 23 颗。验证：若只取 22 颗，可能刚好避开。\nIQ-ANSWER: 23");
+    expect(result.iq.modelAnswered).toBe("23");
+    expect(result.iq.correct).toBe(true);
+  });
+
+  it("marks a wrong answer as ok:true with correct:false", async () => {
+    const result = await run("41");
+    expect(result.ok).toBe(true);
+    expect(result.error).toBeNull();
+    expect(result.iq.correct).toBe(false);
+    expect(result.iq.modelAnswered).toBe("41");
+  });
+
+  it("reports what the model said even when no number is present", async () => {
+    const result = await run("这是一个经典的抽屉原理问题。");
+    expect(result.ok).toBe(true);
+    expect(result.iq.correct).toBe(false);
+    expect(result.iq.modelAnswered).toBe("");
+    expect(result.content).toBe("这是一个经典的抽屉原理问题。");
+  });
+
+  it("fails the probe when the upstream returns an HTTP error", async () => {
+    fetchMock.mockResolvedValue({
+      ok: false,
+      status: 429,
+      text: async () => JSON.stringify({ error: { message: "rate limited" } }),
+    });
+    const result = await pingIqModel("openai/gpt-4o", CANDY_QUESTION, CANDY_ANSWER, "http://127.0.0.1:20127");
+    expect(result.ok).toBe(false);
+    expect(result.error).toMatch(/429/);
+    expect(result.iq).toBeUndefined();
+  });
+
+  it("grades against a non-numeric answer by never matching", async () => {
+    fetchMock.mockResolvedValue(reply("二十三"));
+    const result = await pingIqModel("openai/gpt-4o", CANDY_QUESTION, "23", "http://127.0.0.1:20127");
+    expect(result.ok).toBe(true);
+    expect(result.iq.correct).toBe(false);
+  });
+
+  it("reads Responses-style output_text as well as chat choices", async () => {
+    fetchMock.mockResolvedValue({
+      ok: true,
+      status: 200,
+      text: async () => JSON.stringify({ output_text: "The answer is 23." }),
+    });
+    const result = await pingIqModel("openai/gpt-4o", CANDY_QUESTION, CANDY_ANSWER, "http://127.0.0.1:20127");
+    expect(result.iq.correct).toBe(true);
+  });
+});
+
+describe("iqProbe settings", () => {
+  it("ships the candy puzzle as the built-in default", () => {
+    const settings = mergeWithDefaults({});
+    expect(settings.iqProbe.answer).toBe("23");
+    expect(settings.iqProbe.question).toMatch(/糖果/);
+    // The shipped question has to ask for the marker: without it the grader
+    // falls back to the last number, which mis-reads answer-first replies.
+    expect(settings.iqProbe.question).toContain("IQ-ANSWER:");
+  });
+
+  it("keeps an operator-edited question and answer", () => {
+    const settings = mergeWithDefaults({ iqProbe: { question: "1+1?", answer: "2" } });
+    expect(settings.iqProbe).toEqual({ question: "1+1?", answer: "2" });
+  });
+
+  it("treats a stored null as reset, not as a probe with no answer", () => {
+    // The editor's "Reset to default" writes null. The shallow merge only
+    // substitutes for `undefined`, so null used to survive and leave the
+    // grader comparing against undefined — every model then failed.
+    const settings = mergeWithDefaults({ iqProbe: null });
+    expect(settings.iqProbe.answer).toBe("23");
+    expect(settings.iqProbe.question).toMatch(/糖果/);
+  });
+
+  it("backfills a missing sub-field from the default", () => {
+    const settings = mergeWithDefaults({ iqProbe: { question: "custom" } });
+    expect(settings.iqProbe.question).toBe("custom");
+    expect(settings.iqProbe.answer).toBe("23");
+  });
+
+  it("treats a blank answer as absent, not as the number 0", () => {
+    // Clearing the answer in the editor used to store "": Number("") is 0, so
+    // the grader would have accepted only a model that answered "0".
+    const settings = mergeWithDefaults({ iqProbe: { question: "custom", answer: "   " } });
+    expect(settings.iqProbe.answer).toBe("23");
+  });
+
+  it("keeps an operator's non-numeric answer rather than rewriting it", () => {
+    const settings = mergeWithDefaults({ iqProbe: { question: "q", answer: "0" } });
+    expect(settings.iqProbe.answer).toBe("0");
+  });
+});
