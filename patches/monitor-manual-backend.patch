+// Pull the model's own answer out of a free-form reply.
+//   1. the `IQ-ANSWER: <number>` marker. The shipped question asks for that
+//      line, and it is the only reading that is right for BOTH common reply
+//      shapes — "答案是 23…验证 22 不够" (answer first) and "7+6+4=17…所以
+//      23" (reasoning first). No positional rule handles both;
+//   2. failing the marker, the LAST number in the text. Best effort for an
+//      operator who edited the question without the marker line: models
+//      usually restate the conclusion at the end, so the tail beats the head
+//      ("7+6+4=17，所以最少 23 颗" would read 17 if scanned forward).
+// Returns "" when the reply carries no number at all.
+function extractIqAnswer(content) {
+  const text = String(content || "");
+  if (!text) return "";
+  const marked = text.match(/IQ-ANSWER\s*[:：]\s*(-?\d+(?:\.\d+)?)/i);
+  if (marked) return marked[1];
+  const all = text.match(/-?\d+(?:\.\d+)?/g);
+  return all ? all[all.length - 1] : "";
+}
+
+// Grade a model's reply against the configured answer. Numerals only: the
+// puzzle expects a count, so "二十三" is not accepted.
+function gradeIq(content, expected) {
+  const got = extractIqAnswer(content);
+  if (!got) return false;
+  const want = Number(String(expected).trim());
+  const has = Number(got);
+  if (!Number.isFinite(want) || !Number.isFinite(has)) return false;
+  return Math.abs(has - want) < 1e-9;
+}
+
+// Judge one reply end to end and attach the grading fields the UI renders.
+// A wrong answer is a SUCCESSFUL probe: `ok`/`error` describe the round-trip,
+// `iq.correct` describes the answer — conflating them would paint a red
+// connection failure on a healthy account that simply got the puzzle wrong.
+// `content` is kept so the client can show what the model actually said.
+export function judgeIqReply(content, expected, base = {}) {
+  const modelAnswered = extractIqAnswer(content);
+  const correct = gradeIq(content, expected);
+  return {
+    ...base,
+    iq: { expected: String(expected), modelAnswered, correct },
+    ok: true,
+    error: null,
+    content: String(content || "").slice(0, 2000),
+  };
