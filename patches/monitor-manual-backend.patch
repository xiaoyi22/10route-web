+/**
+ * IQ probe: ask the configured puzzle and grade the reply against the
+ * configured answer. Kept separate from pingModelByKind on purpose — that
+ * function's job is "is this model reachable", and every reasoning-model
+ * soft-pass in it (finish_reason:"length" with empty content, issue #3010)
+ * would happily pass a model that never answered the question at all.
+ *
+ * `question`/`answer` come from the caller (the route reads them from
+ * settings) so a probe stays graded against the answer that was live when the
+ * request started. Billing is the operator's: each call is one full model
+ * round-trip, which is why nothing batches or schedules it.
+ */
+export async function pingIqModel(model, question, answer, baseUrl = `http://127.0.0.1:${process.env.PORT || UPDATER_CONFIG.appPort}`) {
+  const headers = await getInternalHeaders();
+  const start = Date.now();
+
+  const res = await fetch(`${baseUrl}/api/v1/chat/completions`, {
+    method: "POST",
+    headers,
+    body: JSON.stringify({
+      model,
+      // Same reasoning-model budget as the liveness probe: chain-of-thought
+      // models spend this before stating the answer.
+      max_tokens: 1024,
+      stream: false,
+      messages: [{ role: "user", content: String(question || "") }],
+    }),
+    signal: AbortSignal.timeout(60000),
+  });
+  const latencyMs = Date.now() - start;
+
+  const rawText = await res.text().catch(() => "");
+  let parsed = null;
+  try { parsed = rawText ? JSON.parse(rawText) : null; } catch {}
+
+  if (!res.ok) {
+    const detail = parsed?.error?.message || parsed?.msg || parsed?.message || parsed?.error || rawText;
+    return { ok: false, latencyMs, error: `HTTP ${res.status}${detail ? `: ${String(detail).slice(0, 240)}` : ""}`, status: res.status };
+  }
+
+  const providerStatus = parsed?.status;
+  const providerMsg = parsed?.msg || parsed?.message;
+  const hasProviderErrorStatus = providerStatus !== undefined
+    && providerStatus !== null
+    && String(providerStatus) !== "200"
+    && String(providerStatus) !== "0";
+  if (hasProviderErrorStatus && providerMsg) {
+    return {
+      ok: false,
+      latencyMs,
+      status: res.status,
+      error: `Provider status ${providerStatus}: ${String(providerMsg).slice(0, 240)}`,
+    };
+  }
+
+  if (parsed?.error) {
+    const providerError = parsed?.error?.message || parsed?.error || "Provider returned an error";
+    return {
+      ok: false,
+      latencyMs,
+      status: res.status,
+      error: String(providerError).slice(0, 240),
+    };
+  }
+
+  return judgeIqReply(extractCompletionText(parsed), answer, { latencyMs, status: res.status });
+}
