 .log-latency::before { content: ""; position: absolute; left: 0; top: 1px; bottom: 1px; width: 4px; border-radius: 2px; background: var(--latency-bar, var(--dim)); }
 .log-latency-fast { --latency-bar: var(--latency-fast); }
 .log-latency-warning { --latency-bar: var(--latency-warning); }
