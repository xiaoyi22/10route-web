+describe("upstream streaming model persistence", () => {
+  const metadataCases = [
+    { model: "reported-model" },
+    { message: { model: "reported-model" } },
+    { response: { model: "reported-model" } },
+    { modelVersion: "reported-model" },
+    { response: { modelVersion: "reported-model" } },
+    { model: "  ", response: { model: "reported-model" } },
+    { model: 42, message: { model: "reported-model" } },
+  ];
+
+  it.each(metadataCases)("retains split model-only events before filtering: %j", async metadata => {
+    const stream = await openStream({ terminal: true, sourceFormat: formats.OPENAI, upstreamModel: null, metadata });
+    stream.upstreamController.enqueue(new TextEncoder().encode("data: [DONE]\n\n"));
+    stream.upstreamController.close();
+    await drain(stream.reader);
+    const detail = await waitForDetail(stream.id, row => row.status === "success");
+    expect(detail.responseModel).toBe("reported-model");
+    expect(detail.modelMismatch).toBe(true);
+    const response = await getDetails(new Request("http://localhost/api/usage/request-details?provider=test-provider&pageSize=100"));
+    expect(response.status).toBe(200);
+    expect((await response.json()).details.find(row => row.id === stream.id)).toMatchObject({ responseModel: "reported-model", modelMismatch: true });
+  });
+
+  it.each(["OPENAI", "CLAUDE", "OPENAI_RESPONSES"])("keeps the upstream model through %s translation and EOF", async format => {
+    const stream = await openStream({ terminal: true, sourceFormat: formats[format], upstreamModel: "reported-model", waitForTerminal: false });
+    stream.upstreamController.close();
+    await drain(stream.reader);
+    const detail = await waitForDetail(stream.id, row => row.status === "success");
+    expect(detail.responseModel).toBe("reported-model");
+    expect(detail.modelMismatch).toBe(true);
+  });
+
+  it.each(["OPENAI", "OPENAI_RESPONSES"])("keeps a partial upstream model when %s clients cancel", async format => {
+    const stream = await openStream({ terminal: false, sourceFormat: formats[format], upstreamModel: "reported-model" });
+    await stream.reader.cancel("client cancelled mid-stream");
+    const detail = await waitForDetail(stream.id, row => row.status === "error");
+    expect(detail.responseModel).toBe("reported-model");
+    expect(detail.modelMismatch).toBe(true);
+  });
+
+  it("keeps the upstream model on transport failure", async () => {
+    const stream = await openStream({ terminal: false, sourceFormat: formats.CLAUDE, upstreamModel: "reported-model" });
+    stream.upstreamController.error(new Error("socket hang up"));
+    await drain(stream.reader);
+    const detail = await waitForDetail(stream.id, row => row.status !== "streaming");
+    expect(detail.responseModel).toBe("reported-model");
+    expect(detail.modelMismatch).toBe(true);
+  });
+
+  it.each([null, "test-model"])("does not invent a mismatch when upstream model is %j", async upstreamModel => {
+    const stream = await openStream({ terminal: true, sourceFormat: formats.OPENAI_RESPONSES, upstreamModel, waitForTerminal: false });
+    stream.upstreamController.close();
+    await drain(stream.reader);
+    const detail = await waitForDetail(stream.id, row => row.status === "success");
+    expect(detail.responseModel || null).toBe(upstreamModel);
+    expect(detail.modelMismatch).not.toBe(true);
+  });
+});
