+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { spawnSync } from "node:child_process";
+
+let testApi;
+try { testApi = await import("vitest"); }
+catch (error) {
+  if (error.code !== "ERR_MODULE_NOT_FOUND") throw error;
+  testApi = await import("node:test");
+}
+const { describe, it, beforeEach, afterEach } = testApi;
+const repoRoot = fileURLToPath(new URL("../../", import.meta.url));
+const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "10router-ag-fix1-"));
+process.env.DATA_DIR = tempDir;
+// proxyFetch must capture the stub, not Node's network implementation.
+let mockFetch = async url => { throw new Error(`Unexpected offline fetch: ${url}`); };
+globalThis.fetch = (...args) => mockFetch(...args);
+const {
+  persistQuarantine, quarantineConnection, resetQuarantineMemory,
+  isAntigravityBlocked, getQuarantinedConnection, isConnectionQuarantined,
+  classifyAntigravityError,
+} = await import("../../open-sse/services/antigravityQuarantine.js");
+const repo = await import("../../src/lib/db/repos/connectionsRepo.js");
+const { getAdapter } = await import("../../src/lib/db/driver.js");
+const { handleFusionChat } = await import("../../open-sse/services/combo.js");
+const { handleChatCore } = await import("../../open-sse/handlers/chatCore.js");
+const { AntigravityExecutor } = await import("../../open-sse/executors/antigravity.js");
+const { getAllAccessTokens } = await import("../../open-sse/services/tokenRefresh.js");
+const { fetchAntigravityUserQuotaSummaryCached } = await import("../../open-sse/services/usage/antigravityWeeklyQuota.js");
+const { fetchWithTimeout } = await import("../../open-sse/services/usage/shared.js");
+const { proxyAwareFetch } = await import("../../open-sse/utils/proxyFetch.js");
+const log = { info() {}, warn() {}, error() {}, debug() {} };
+const model = "gemini-3.8-flash-high";
+const body = { model: `ag/${model}`, stream: false, messages: [{ role: "user", content: "offline" }] };
+const success = () => Response.json({ choices: [{ message: { content: "offline answer" } }] });
+const tos = () => new Response(JSON.stringify({ error: { message: "This service has been disabled in this account for violation of Terms of Service." } }), { status: 403 });
+const proxy = { connectionProxyEnabled: true, connectionProxyUrl: "http://127.0.0.1:9", strictProxy: false };
+
+async function account(name) {
+  return repo.createProviderConnection({ provider: "antigravity", authType: "oauth", name,
+    email: `${crypto.randomUUID()}@example.invalid`, accessToken: `token-${name}`,
+    refreshToken: `refresh-${name}`, projectId: `project-${name}`, isActive: true });
+}
+function core(credentials, executor, provider = "antigravity") {
+  return handleChatCore({ body: { ...body }, modelInfo: { provider, model: provider === "antigravity" ? model : "gpt-4o" },
+    credentials: { ...credentials }, connectionId: credentials.id, _executorOverride: executor });
+}
+function remoteRelease(id) {
+  const child = spawnSync(process.execPath, ["--import", "./tests/test-loader.mjs", "--input-type=module", "-e", `
+    globalThis.fetch = async () => { throw new Error('Network forbidden'); };
+    const { releaseAntigravityQuarantine } = await import('./src/lib/db/repos/connectionsRepo.js');
+    if (!await releaseAntigravityQuarantine(${JSON.stringify(id)})) throw new Error('Release failed');
+  `], { cwd: repoRoot, env: { ...process.env, DATA_DIR: tempDir }, encoding: "utf8", timeout: 15000 });
+  assert.equal(child.status, 0, child.stdout + child.stderr);
+}
+
+describe("AG P0 fix1 report regressions (offline)", () => {
+  beforeEach(async () => {
+    resetQuarantineMemory();
+    repo.registerQuarantinePersistenceHandler();
+    mockFetch = async url => { throw new Error(`Unexpected offline fetch: ${url}`); };
+    for (const c of await repo.getProviderConnections({ provider: "antigravity" })) await repo.deleteProviderConnection(c.id);
+  });
+  afterEach(() => resetQuarantineMemory());
+
+  for (const successfulPanels of [2, 1, 0]) {
+    it(`R1 stops fusion after TOS with ${successfulPanels} successful panels`, async () => {
+      const stopped = tos();
