--- /dev/null
+++ b/tests/unit/antigravity-retry-budget.test.js
@@ -0,0 +1,236 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+let testApi;
+try { testApi = await import("vitest"); }
+catch (error) {
+  if (error.code !== "ERR_MODULE_NOT_FOUND") throw error;
+  testApi = await import("node:test");
+}
+const { describe, it, beforeEach, afterEach } = testApi;
+
+// Offline isolation BEFORE importing the real entry/DB (same pattern as antigravity-p0-fix1).
+const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "10router-ag-budget-"));
+process.env.DATA_DIR = tempDir;
+let fetchLog = [];
+let mockFetch = async url => { throw new Error(`Unexpected offline fetch: ${url}`); };
+globalThis.fetch = (...args) => mockFetch(...args);
+
+const repo = await import("../../src/lib/db/repos/connectionsRepo.js");
+const { updateSettings } = await import("../../src/lib/db/repos/settingsRepo.js");
+const { resetQuarantineMemory } = await import("../../open-sse/services/antigravityQuarantine.js");
+const { handleChat } = await import("../../src/sse/handlers/chat.js");
+const { handleChatCore } = await import("../../open-sse/handlers/chatCore.js");
+const { BaseExecutor } = await import("../../open-sse/executors/base.js");
+const { AntigravityExecutor } = await import("../../open-sse/executors/antigravity.js");
+const budgetMod = await import("../../open-sse/utils/agRequestBudget.js");
+const { createAgRequestBudget, isAgRequestBudgetExhausted } = budgetMod;
+
+const MODEL = "gemini-3.8-flash-high";
+const log = { info() {}, warn() {}, error() {}, debug() {} };
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+const genResponse = (status, message) => Response.json({ error: { message } }, { status });
+function request(model) {
+  return new Request("http://offline.invalid/v1/chat/completions", {
+    method: "POST", headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ model, stream: false, messages: [{ role: "user", content: "offline retry budget" }] }),
+  });
+}
+async function account(name, priority) {
+  return repo.createProviderConnection({ provider: "antigravity", authType: "oauth", name, priority,
+    email: `${name}@example.invalid`, accessToken: `token-${name}`, refreshToken: `refresh-${name}`,
+    projectId: `project-${name}`, expiresAt: new Date(Date.now() + 3600000).toISOString(), isActive: true });
+}
+const isOauth = entry => entry.url.includes("oauth2");
+const genCalls = () => fetchLog.filter(e => !isOauth(e));
+
+// a) and d) exercise the real backoff sleep (capped at 15s by design), so the
+// 5s vitest default is structurally too small — pin this file at 30s per test.
+describe("AG P1-1 unified request retry budget (offline)", { timeout: 30000 }, () => {
+  beforeEach(async () => {
+    resetQuarantineMemory();
+    repo.registerQuarantinePersistenceHandler();
+    fetchLog = [];
+    mockFetch = async url => { throw new Error(`Unexpected offline fetch: ${url}`); };
+    for (const c of await repo.getProviderConnections()) await repo.deleteProviderConnection(c.id);
+    await updateSettings({ requireApiKey: false, rtkEnabled: false, headroomEnabled: false,
+      pxpipeEnabled: false, outboundProxyEnabled: false, comboStrategies: {},
+      providerStrategies: { antigravity: { fallbackStrategy: "round-robin", stickyRoundRobinLimit: 1, earliestExpiryFirst: false } } });
+  });
+  afterEach(() => resetQuarantineMemory());
+
+  // a) Three 429s on account #1 consume the generation cap; account fallback then
+  //    pays the credential cap and the executor refuses its HTTP entirely.
+  it("a: generation cap halts cross-account sequence with zero HTTP on refused account", async () => {
+    await account("a1", 1);
+    await account("a2", 2);
+    const queue = [
+      () => genResponse(429, "quota exhausted"),
+      () => genResponse(429, "quota exhausted"),
+      () => genResponse(429, "quota exhausted"),
+      () => { throw new Error(`Budget must refuse a 4th generation HTTP call`); },
+    ];
+    mockFetch = async (url, options) => {
+      const entry = { url: String(url), auth: options?.headers?.Authorization };
+      fetchLog.push(entry);
+      if (isOauth(entry)) return Response.json({ access_token: "token-a2-refreshed", expires_in: 1 });
+      const next = queue.shift();
+      if (!next) throw new Error("Unexpected extra generation call beyond the scripted sequence");
+      return next();
+    };
+    const response = await handleChat(request(`ag/${MODEL}`));
+    assert.equal(response.status, 503);
+    const body = await response.json();
+    assert.match(body.error.message, /budget exhausted/i);
+    assert.match(body.error.message, /retry/i);
+    // a1's 429 retry loop (registry attempts:3) is gated by the generation cap
+    // INSIDE the executor: attempt #4 is refused with zero HTTP, chatCore marks
+    // the result budgetExhausted, and the account loop halts before a2 is ever
+    // selected — no refresh, no second credential. One logical request can
+    // never exceed 3 upstream generations, retries included.
+    assert.equal(body.error.budget.generationAttempts, 3, "Exactly 3 upstream generation HTTP calls");
+    assert.equal(body.error.budget.refreshAttempts, 0, "halt happens before any refresh");
+    assert.equal(body.error.budget.credentialsTried, 1, "second account never selected");
+    const gens = genCalls();
+    assert.equal(gens.length, 3);
+    assert.ok(gens.every(g => g.url.includes("/v1internal:generateContent")));
+    assert.deepEqual(gens.map(g => g.auth), ["Bearer token-a1", "Bearer token-a1", "Bearer token-a1"]);
+    assert.ok(!gens.some(g => g.auth === "Bearer token-a2"), "a2 generation refused: no HTTP with the second credential");
+    assert.equal(fetchLog.filter(isOauth).length, 0);
+    await sleep(50);
+    assert.equal(fetchLog.length, 3, "No trailing HTTP after the budget error returned");
+  });
+
+  // b) Once the budget is exhausted, an execute() attempt must send zero HTTP.
+  it("b: exhausted budget refuses generation with zero HTTP and a budget body", async () => {
+    const conn = await account("b1", 1);
+    const budget = createAgRequestBudget();
+    for (let i = 0; i < 3; i++) assert.equal(budget.countGeneration(), true);
+    assert.equal(budget.countGeneration(), false);
+    fetchLog = [];
+    mockFetch = async (url) => { fetchLog.push({ url: String(url) }); return genResponse(200, "should-not-run"); };
+    const executor = new AntigravityExecutor();
+    const { response } = await executor.execute({ model: MODEL, body: {}, stream: false,
+      credentials: { ...conn }, signal: undefined, log, agRequestBudget: budget });
+    assert.equal(fetchLog.length, 0, "Budget-exhausted execute must not touch the network");
+    assert.equal(response.status, 503);
+    assert.equal(response.budgetExhausted, true);
