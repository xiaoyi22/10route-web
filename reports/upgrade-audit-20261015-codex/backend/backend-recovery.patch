+    assert.deepEqual(attempts, [true, false]);
+    attempts.length = 0;
+    await assert.rejects(proxyAwareFetch("https://non-ag.invalid/usage", {}, { ...proxy, strictProxy: true }), /strictProxy=true/);
+    assert.deepEqual(attempts, [true]);
+  });
+
+  for (const action of ["disable", "delete"]) {
+    it(`R3 local ${action} blocks stale execute without inventing upstream TOS`, async () => {
+      const conn = await account(`local-${action}`);
+      if (action === "disable") await repo.updateProviderConnection(conn.id, { isActive: false });
+      else await repo.deleteProviderConnection(conn.id);
+      let networkCalls = 0;
+      mockFetch = async () => { networkCalls++; return success(); };
