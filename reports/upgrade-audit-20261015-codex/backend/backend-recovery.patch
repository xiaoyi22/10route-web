diff --git a/tests/unit/stream-detail-finalization.test.js b/tests/unit/stream-detail-finalization.test.js
new file mode 100644
--- /dev/null
+++ b/tests/unit/stream-detail-finalization.test.js
@@ -0,0 +1,223 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+
+const originalDataDir = process.env.DATA_DIR;
+let tempDir;
+let db;
+let handleStreamingResponse;
+let buildOnStreamComplete;
+let buildRequestDetail;
+let createStreamController;
+let formats;
+let getDetails;
+let getAdapter;
+
+beforeAll(async () => {
+  tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "10router-stream-finalization-"));
+  process.env.DATA_DIR = tempDir;
+  vi.resetModules();
+  db = await import("@/lib/db/index.js");
+  await db.initDb();
+  await db.updateSettings({ enableObservability: true, observabilityBatchSize: 1 });
+  ({ handleStreamingResponse, buildOnStreamComplete } = await import("../../open-sse/handlers/chatCore/streamingHandler.js"));
+  ({ buildRequestDetail } = await import("../../open-sse/handlers/chatCore/requestDetail.js"));
+  ({ createStreamController } = await import("../../open-sse/utils/streamHandler.js"));
+  ({ FORMATS: formats } = await import("../../open-sse/translator/formats.js"));
+  ({ GET: getDetails } = await import("../../src/app/api/usage/request-details/route.js"));
+  ({ getAdapter } = await import("@/lib/db/driver.js"));
+});
+
+afterAll(() => {
+  if (tempDir) fs.rmSync(tempDir, { recursive: true, force: true });
+  if (originalDataDir === undefined) delete process.env.DATA_DIR;
+  else process.env.DATA_DIR = originalDataDir;
+});
+
+async function waitForDetail(id, predicate = () => true) {
+  for (let attempt = 0; attempt < 100; attempt += 1) {
+    const detail = await db.getRequestDetailById(id);
+    if (detail && predicate(detail)) return detail;
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  throw new Error("Request detail did not settle: " + id);
+}
+
+async function openStream({ terminal, usage = { prompt_tokens: 11, completion_tokens: 2 }, sourceFormat, waitForTerminal = true }) {
+  let upstreamController;
+  const upstream = new Response(new ReadableStream({
+    start(controller) {
+      upstreamController = controller;
+      controller.enqueue(new TextEncoder().encode("data: " + JSON.stringify({
+        id: "chat-test", object: "chat.completion.chunk", model: "test-model",
+        choices: [{ index: 0, delta: { content: "hello" }, finish_reason: terminal ? "stop" : null }],
+        ...(usage ? { usage } : {}),
+      }) + "\n\n"));
+    },
+  }), { headers: { "content-type": "text/event-stream" } });
+  const body = { model: "test-model", messages: [{ role: "user", content: "hi" }], stream: true };
+  const args = { provider: "test-provider", model: "test-model", connectionId: "test-connection",
+    requestStartTime: Date.now() - 20, body, stream: true, translatedBody: body,
+    clientRawRequest: { endpoint: sourceFormat === formats.OPENAI ? "/v1/chat/completions" : sourceFormat === formats.CLAUDE ? "/v1/messages" : "/v1/responses", upstreamEndpoint: "/v1/chat/completions" },
+  };
+  const completion = buildOnStreamComplete(args);
+  const result = await handleStreamingResponse({ ...args, ...completion, providerResponse: upstream,
+    sourceFormat, targetFormat: formats.OPENAI, streamController: createStreamController({ provider: args.provider, model: args.model }),
+  });
+  const reader = result.response.body.getReader();
+  let text = "";
+  while (!text.includes(terminal && waitForTerminal && sourceFormat === formats.OPENAI_RESPONSES ? "response.completed" : "hello")) {
+    const chunk = await reader.read();
+    if (chunk.done) throw new Error("Expected streamed output");
+    text += new TextDecoder().decode(chunk.value);
+  }
+  return { reader, upstreamController, id: completion.streamDetailId };
+}
+
+async function drain(reader) {
+  let text = "";
+  for (;;) {
+    const chunk = await reader.read();
+    if (chunk.done) return text;
+    text += new TextDecoder().decode(chunk.value);
+  }
+}
