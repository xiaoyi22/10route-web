+      return Response.json({ groups: [] });
+    };
+    let error;
+    try {
+      await fetchAntigravityUserQuotaSummaryCached(conn.accessToken, conn.projectId, "https://quota.invalid/summary", "offline", proxy,
+        { forceRefresh: true, credentials: conn });
+    } catch (e) { error = e; }
+    assert.deepEqual(attempts, [{ proxy: true, blocked: false }], "No direct send after isolation");
+    assert.equal(error?.code, "AG_TOS_QUARANTINED");
