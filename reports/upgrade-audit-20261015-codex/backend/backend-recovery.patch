+    );
+    mocks.getCustomModels.mockResolvedValue([
+      { providerAlias: NODE_ID, id: "a", type: "llm", name: "a" },
+    ]);
+
+    const ids = (await buildModelsList([LLM_KIND])).map((m) => m.id);
+    expect(ids).toContain("fw/a");
+  });
+
+  it("fetches compatible provider catalogs concurrently", async () => {
+    const secondNodeId = "openai-compatible-chat-test-node";
+    mocks.getProviderNodes.mockResolvedValue([
+      { id: NODE_ID, type: "openai-compatible", name: "Fengwind" },
+      { id: secondNodeId, type: "openai-compatible", name: "Second" },
+    ]);
+    mocks.getProviderConnections.mockResolvedValue([
+      {
+        id: "conn-fw",
+        provider: NODE_ID,
+        authType: "apikey",
+        isActive: true,
+        apiKey: "sk-test",
+        providerSpecificData: { baseUrl: "https://api.fengwind.com/v1", prefix: "fw", apiType: "chat" },
+      },
+      {
+        id: "conn-second",
+        provider: secondNodeId,
+        authType: "apikey",
+        isActive: true,
+        apiKey: "sk-test-second",
+        providerSpecificData: { baseUrl: "https://second.example/v1", prefix: "second", apiType: "chat" },
+      },
+    ]);
+    mocks.getCustomModels.mockResolvedValue([]);
+
+    let activeRequests = 0;
+    let maxConcurrentRequests = 0;
+    global.fetch = vi.fn((input) => {
+      activeRequests += 1;
+      maxConcurrentRequests = Math.max(maxConcurrentRequests, activeRequests);
+      const modelId = String(input).includes("second.example") ? "second-model" : "first-model";
+      return new Promise((resolve) => {
+        setTimeout(() => {
+          activeRequests -= 1;
+          resolve(new Response(JSON.stringify({ data: [{ id: modelId }] }), { status: 200 }));
+        }, 20);
+      });
+    });
+
+    const ids = (await buildModelsList([LLM_KIND])).map((model) => model.id);
+
+    expect(maxConcurrentRequests).toBe(2);
+    expect(ids).toEqual(expect.arrayContaining(["fw/first-model", "second/second-model"]));
+  });
+});
