+++ b/src/lib/db/repos/distributionRepo.js
@@ -0,0 +1,105 @@
+import { getAdapter } from "../driver.js";
+import { parseJson, stringifyJson } from "../helpers/jsonCol.js";
+
+// ───────────────────────────────────────────────────────────────────────────
+// Downstream distribution allowlist.
+//
+// The gateway serves an OpenAI-compatible /v1/models that lists every model any
+// active connection can reach. With dozens of upstream providers that catalog
+// grows far past what a downstream client wants, and there was no way to narrow
+// it: the dashboard could only disable models one by one, and disabled rows are
+// per-provider, so a client still saw the union of everything else.
+//
+// This store holds ONE global switch (the operator runs a single account; there
+// is no per-API-key scoping):
+//
+//   mode:  "all"       → publish everything (default; identical to old behavior)
+//          "allowlist" → publish ONLY the ids in `models`, and reject calls to
+//                        anything else at the chat entry point.
+//   models: string[]   → full route ids exactly as /v1/models emits them
+//                        ("fw/gpt-5", "cc/claude-sonnet-4-5", a combo name, …).
+//
+// Stored in the shared `kv` table under its own scope, so there is no schema
+// migration and export/import of the DB carries the setting for free.
+// ───────────────────────────────────────────────────────────────────────────
+
+const SCOPE = "distribution";
+const MODE_KEY = "mode";
+const MODELS_KEY = "models";
+
+export const DISTRIBUTION_MODES = ["all", "allowlist"];
+
+// The chat path reads this on EVERY request, so the row is cached and only
+// re-read after a write. A stale window of a few milliseconds is acceptable;
+// correctness across processes is not required (single systemd service).
+let cache = null;
+
+async function readState() {
+  const db = await getAdapter();
+  const rows = db.all(`SELECT key, value FROM kv WHERE scope = ?`, [SCOPE]);
+  const raw = new Map(rows.map((r) => [r.key, r.value]));
+
+  const mode = raw.has(MODE_KEY) ? parseJson(raw.get(MODE_KEY), null) : null;
+  const models = raw.has(MODELS_KEY) ? parseJson(raw.get(MODELS_KEY), null) : null;
+
+  return {
+    // Anything unrecognised falls back to "all" — a corrupted row must never
+    // silently start hiding models from clients.
+    mode: DISTRIBUTION_MODES.includes(mode) ? mode : "all",
+    models: Array.isArray(models) ? models.filter((id) => typeof id === "string" && id.trim() !== "") : [],
+  };
+}
+
+/** Current distribution config. Never throws: a read failure degrades to "all". */
+export async function getDistribution() {
+  if (cache) return cache;
+  try {
+    cache = await readState();
+  } catch (error) {
+    console.log("Distribution config unavailable:", error?.message || error);
+    return { mode: "all", models: [] };
+  }
+  return cache;
+}
+
+const WRITE_ROW = `INSERT INTO kv(scope, key, value) VALUES(?, ?, ?) ON CONFLICT(scope, key) DO UPDATE SET value = excluded.value`;
+const DELETE_ROW = `DELETE FROM kv WHERE scope = ? AND key = ?`;
+
+/**
+ * Replace the distribution config. `mode` must be one of DISTRIBUTION_MODES;
+ * `models` is normalised to a deduped list of trimmed ids. Returns the stored
+ * state so the API can echo exactly what was persisted.
+ */
+export async function setDistribution({ mode, models } = {}) {
+  const nextMode = DISTRIBUTION_MODES.includes(mode) ? mode : "all";
+  const nextModels =
+    mode === undefined && models === undefined
+      ? (await getDistribution()).models
+      : [...new Set((Array.isArray(models) ? models : []).map((id) => String(id).trim()).filter(Boolean))];
+
+  const db = await getAdapter();
+  db.transaction(() => {
+    db.run(WRITE_ROW, [SCOPE, MODE_KEY, stringifyJson(nextMode)]);
+    if (nextModels.length === 0) db.run(DELETE_ROW, [SCOPE, MODELS_KEY]);
+    else db.run(WRITE_ROW, [SCOPE, MODELS_KEY, stringifyJson(nextModels)]);
+  });
+
+  cache = { mode: nextMode, models: nextModels };
+  return cache;
+}
+
+/**
+ * Is `id` (a full route id as /v1/models emits it) publishable downstream?
+ * Always true under "all". Under "allowlist" only listed ids pass.
+ */
+export function isDistributed(id, state) {
+  const current = state || cache;
+  if (!current || current.mode !== "allowlist") return true;
+  if (typeof id !== "string" || id.trim() === "") return false;
+  return current.models.includes(id.trim());
+}
+
+/** Test seam: drop the cached row so the next read hits the DB. */
+export function invalidateDistributionCache() {
+  cache = null;
+}
