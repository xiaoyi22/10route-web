+        refreshCredentials: async () => { refreshes++; if (failure === "throw") throw new Error("offline refresh failure"); return null; } });
+      assert.equal(refreshes, 1);
+      assert.equal(generated, 1);
+      assert.equal(result.status, 401);
+      assert.equal(isConnectionQuarantined(conn.id), false);
+    });
+  }
+
+  it("R4 non-AG 401 retains three failed refresh attempts", async () => {
+    let refreshes = 0;
+    const result = await core({ id: "offline-openai", accessToken: "old" }, { noAuth: false,
+      execute: async () => ({ response: new Response("unauthenticated", { status: 401 }), url: "https://offline.invalid" }),
+      refreshCredentials: async () => { refreshes++; return null; } }, "openai");
+    assert.equal(refreshes, 3);
+    assert.equal(result.status, 401);
+  });
+
+  for (const ok of [false, true]) {
+    it(`R4 concurrent real AG 401 recovery shares one ${ok ? "successful" : "failed"} refresh`, async () => {
+      const conn = await account(`concurrent-${ok}`);
+      let refreshes = 0, generated = 0;
+      const releases = [];
+      let reached;
+      const bothRefreshing = new Promise(resolve => { reached = resolve; });
+      const executor = new AntigravityExecutor();
+      let entered = 0;
+      const realRefresh = executor.refreshCredentials.bind(executor);
+      executor.refreshCredentials = (...args) => {
+        const result = realRefresh(...args);
+        if (++entered === 2) reached();
+        return result;
+      };
+      mockFetch = async (url, options) => {
+        if (String(url).includes("oauth2")) {
+          refreshes++;
+          await new Promise(resolve => { releases.push(resolve); });
+          return ok ? Response.json({ access_token: "new-token", expires_in: 3600 }) : new Response("offline refresh failure", { status: 400 });
+        }
+        generated++;
+        return options.headers.Authorization === "Bearer new-token" ? success() : new Response("unauthenticated", { status: 401 });
+      };
+      const pending = Promise.all([core(conn, executor), core(conn, executor)]);
+      await bothRefreshing;
+      // Both callers have entered the real refresh method; let its async guards settle.
+      await new Promise(resolve => setImmediate(resolve));
+      // Release every in-flight mock without leaving the buggy baseline hanging.
+      mockFetch = async (url, options) => {
+        if (String(url).includes("oauth2")) { refreshes++; return new Response("offline failure", { status: 400 }); }
+        generated++;
+        return options.headers.Authorization === "Bearer new-token" ? success() : new Response("unauthenticated", { status: 401 });
+      };
+      for (const release of releases) release();
+      const results = await pending;
+      assert.equal(refreshes, 1);
+      assert.equal(generated, ok ? 4 : 2);
+      assert.ok(results.every(r => ok ? r.success : r.status === 401));
+    });
+  }
+
+  it("R5 remote release survives late ordinary write before any guard runs", async () => {
+    const conn = await account("remote-release-write");
+    await persistQuarantine(conn.id);
+    assert.equal(getQuarantinedConnection(conn.id).persisted, true);
+    remoteRelease(conn.id);
+    assert.equal((await repo.getProviderConnectionById(conn.id)).isActive, true);
+    await repo.updateProviderConnection(conn.id, { accessToken: "late-token", quotaCheckedAt: new Date().toISOString(), testStatus: "active", lastError: null });
+    const saved = await repo.getProviderConnectionById(conn.id);
+    assert.equal(saved.isActive, true, "Late write must not resurrect already released memory event");
+    assert.equal(saved.quarantine, undefined);
+    assert.equal(saved.accessToken, "late-token");
+    assert.equal(await isAntigravityBlocked(conn), false);
+  });
+
+  it("R5 remote release survives OAuth dedup write before any guard runs", async () => {
+    const conn = await account("remote-release-oauth");
+    await persistQuarantine(conn.id);
+    remoteRelease(conn.id);
+    const saved = await repo.createProviderConnection({ ...conn, accessToken: "relogin", testStatus: "active" });
+    assert.equal(saved.id, conn.id);
+    assert.equal(saved.isActive, true);
+    assert.equal(saved.quarantine, undefined);
+    assert.equal(await isAntigravityBlocked(conn), false);
+  });
+
+  it("R5 release does not discard a new unpersisted TOS event on ordinary write", async () => {
+    const conn = await account("remote-release-new-event");
+    await persistQuarantine(conn.id);
+    remoteRelease(conn.id);
+    const db = await getAdapter();
+    db.exec(`CREATE TRIGGER ag_fix1_fail BEFORE UPDATE ON providerConnections WHEN OLD.id = '${conn.id}' BEGIN SELECT RAISE(ABORT, 'offline injected write failure'); END`);
+    try { assert.equal((await persistQuarantine(conn.id)).persisted, false); }
+    finally { db.exec("DROP TRIGGER ag_fix1_fail"); }
+    const pendingEvent = getQuarantinedConnection(conn.id);
+    assert.equal(pendingEvent.persisted, false);
+    await repo.updateProviderConnection(conn.id, { isActive: true, testStatus: "active", quarantine: null, lastError: null });
+    const saved = await repo.getProviderConnectionById(conn.id);
+    assert.equal(saved.isActive, false);
+    assert.equal(saved.quarantine.quarantinedAt, pendingEvent.quarantinedAt);
+    assert.equal(await isAntigravityBlocked(conn), true);
+  });
+
+  it("R6 batch refresh rechecks stale active snapshot by connection identity", async () => {
+    const conn = await account("batch-stale");
+    await persistQuarantine(conn.id);
+    resetQuarantineMemory(); // Must read persisted state, not just a process-local map.
+    let networkCalls = 0;
+    mockFetch = async () => { networkCalls++; return Response.json({ access_token: "should-not-refresh", expires_in: 3600 }); };
+    const tokens = await getAllAccessTokens({ connections: [conn] });
+    assert.equal(networkCalls, 0);
+    assert.deepEqual(tokens, {});
+  });
+
+  it("R6 batch retains quarantine snapshot without an ID and healthy non-AG refresh", async () => {
+    let networkCalls = 0;
+    mockFetch = async () => { networkCalls++; return Response.json({ access_token: "healthy-token", expires_in: 3600 }); };
+    const tokens = await getAllAccessTokens({ connections: [
+      { provider: "antigravity", isActive: true, refreshToken: "offline-blocked", quarantine: { reason: "TOS_VIOLATION" } },
+      { provider: "gemini-cli", isActive: true, refreshToken: "offline-healthy" },
+    ] });
+    assert.equal(networkCalls, 1);
+    assert.equal(tokens.antigravity, undefined);
+    assert.equal(tokens["gemini-cli"].accessToken, "healthy-token");
+  });
+});
