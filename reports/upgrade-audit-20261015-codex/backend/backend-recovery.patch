+  it("control: forced streaming preserves truncated tool finish", async () => {
+    fixture = "tool-length";
+    const result = await call({ stream: false, force: true });
+    expect(JSON.parse(result.text).choices[0].finish_reason).toBe("length");
+  });
+  it("native synchronous reply must preserve truncated tool finish", async () => {
+    fixture = "tool-length";
+    const result = await call({ stream: false });
+    expect(JSON.parse(result.text).choices[0].finish_reason).toBe("length");
