+  it.each([["content_filter", "content_filter"], ["other", "tool_calls"], ["stop", "tool_calls"]])(
+    "preserves exceptional tool finish and normalizes legacy finish: %s", async (reason, expected) => {
+      fixture = `tool-${reason}`;
+      const result = await call({ stream: false });
+      expect(JSON.parse(result.text).choices[0].finish_reason).toBe(expected);
+    }
+  );
+  it("regular synchronous handling preserves Responses cache details for Chat", async () => {
+    fixture = "responses-cache";
