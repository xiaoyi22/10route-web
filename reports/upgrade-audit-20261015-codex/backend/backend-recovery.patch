+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+let testApi;
+try { testApi = await import("vitest"); }
+catch (error) {
+  if (error.code !== "ERR_MODULE_NOT_FOUND") throw error;
+  testApi = await import("node:test");
+}
+const { describe, it, beforeEach } = testApi;
+
+const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "10router-ag-quota-"));
+process.env.DATA_DIR = tempDir;
+globalThis.fetch = async () => { throw new Error("offline"); };
+
+const repo = await import("../../src/lib/db/repos/connectionsRepo.js");
+const { updateSettings } = await import("../../src/lib/db/repos/settingsRepo.js");
+const { markAccountUnavailable } = await import("../../src/sse/services/auth.js");
+const { MAX_RATE_LIMIT_COOLDOWN_MS } = await import("../../open-sse/config/errorConfig.js");
+
+const logs = [];
+const log = { info: (...a) => logs.push(["info", ...a]), warn: (...a) => logs.push(["warn", ...a]), error: (...a) => logs.push(["error", ...a]), debug: () => {} };
+const LOCK = "modelLock_gemini-3.8-flash-high";
+
+async function account(name) {
+  return repo.createProviderConnection({ provider: "antigravity", authType: "oauth", name,
+    email: `${name}@example.invalid`, accessToken: "t", refreshToken: "r", isActive: true });
+}
+const lockMs = conn => new Date(conn[LOCK]).getTime() - Date.now();
+
+describe("AG P1-2 quota reset honored (no early probing)", () => {
+  beforeEach(async () => {
+    logs.length = 0;
+    for (const c of await repo.getProviderConnections()) await repo.deleteProviderConnection(c.id);
+    await updateSettings({ requireApiKey: false, rtkEnabled: false, headroomEnabled: false, pxpipeEnabled: false });
+  });
+
+  it("AG 429 with 3h reset locks the model ~3h, not the 30-minute cap", async () => {
+    const conn = await account("q-3h");
+    const r = await markAccountUnavailable(conn.id, 429, "Individual quota reached. Resets in 3h", "antigravity", "gemini-3.8-flash-high", Date.now() + 3 * 3600 * 1000);
+    assert.equal(r.shouldFallback, true);
+    assert.ok(r.cooldownMs > 2.9 * 3600 * 1000, `cooldown must be ~3h, got ${r.cooldownMs}`);
+    assert.ok(r.cooldownMs <= 3 * 3600 * 1000);
+    const saved = await repo.getProviderConnectionById(conn.id);
+    const lm = lockMs(saved);
+    assert.ok(lm > 2.9 * 3600 * 1000 && lm <= 3 * 3600 * 1000, `DB lock must be ~3h, got ${lm}ms`);
+    assert.ok(!logs.some(l => l[0] === "warn" && /clamp/i.test(l[1] || "")), "no clamp warning for a trusted reset");
+  });
+
+  it("AG 429 with 5h window (typical) locks full window", async () => {
+    const conn = await account("q-5h");
+    const r = await markAccountUnavailable(conn.id, 429, "quota reset", "antigravity", "gemini-3.8-flash-high", Date.now() + 5 * 3600 * 1000);
+    assert.ok(r.cooldownMs > 4.9 * 3600 * 1000);
+  });
+
+  it("absurd far-future AG reset (30d) is clamped to the generic cap and warns", async () => {
+    const conn = await account("q-30d");
+    // markAccountUnavailable logs through the module-level logger (console.warn),
+    // not the caller's log object — capture the real sink.
+    const warnings = [];
+    const original = console.warn;
+    console.warn = (...args) => warnings.push(args.join(" "));
+    let r;
+    try {
+      r = await markAccountUnavailable(conn.id, 429, "weird body", "antigravity", "gemini-3.8-flash-high", Date.now() + 30 * 24 * 3600 * 1000);
+    } finally { console.warn = original; }
+    assert.equal(r.cooldownMs, MAX_RATE_LIMIT_COOLDOWN_MS, "bogus reset must not sleep 30 days");
+    assert.ok(warnings.some(w => /clamp|exceed/i.test(w)), "must warn about clamping");
+  });
+
+  it("past reset falls back to generic backoff (no negative lock, no instant re-probe)", async () => {
+    const conn = await account("q-past");
+    const r = await markAccountUnavailable(conn.id, 429, "stale reset", "antigravity", "gemini-3.8-flash-high", Date.now() - 5000);
+    assert.equal(r.shouldFallback, true);
+    assert.ok(r.cooldownMs > 0, "backoff cooldown must be positive");
+    const saved = await repo.getProviderConnectionById(conn.id);
+    assert.ok(new Date(saved[LOCK]).getTime() > Date.now(), "lock must be in the future");
+  });
+
+  it("non-AG providers keep the 30-minute cap (baseline preserved)", async () => {
+    const conn = repo.createProviderConnection;
+    void conn;
+    const codex = await repo.createProviderConnection({ provider: "codex", authType: "oauth", name: "cx",
+      email: "cx@example.invalid", accessToken: "t", refreshToken: "r", isActive: true });
+    const r = await markAccountUnavailable(codex.id, 429, "usage_limit_reached", "codex", "gpt-5.5", Date.now() + 3 * 3600 * 1000);
+    assert.equal(r.cooldownMs, MAX_RATE_LIMIT_COOLDOWN_MS, "codex long reset stays capped as before");
+  });
+});
diff --git a/tests/unit/antigravity-refresh-singleflight.test.js b/tests/unit/antigravity-refresh-singleflight.test.js
new file mode 100644
--- /dev/null
+++ b/tests/unit/antigravity-refresh-singleflight.test.js
@@ -0,0 +1,116 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+let testApi;
+try { testApi = await import("vitest"); }
+catch (error) {
+  if (error.code !== "ERR_MODULE_NOT_FOUND") throw error;
+  testApi = await import("node:test");
+}
+const { describe, it, beforeEach, afterEach } = testApi;
+
+const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "10router-ag-singleflight-"));
+process.env.DATA_DIR = tempDir;
+
+const repo = await import("../../src/lib/db/repos/connectionsRepo.js");
+const { updateSettings } = await import("../../src/lib/db/repos/settingsRepo.js");
+const { persistQuarantine, resetQuarantineMemory } = await import("../../open-sse/services/antigravityQuarantine.js");
+const ocm = await import("../../open-sse/services/oauthCredentialManager.js");
+const tr = await import("../../open-sse/services/tokenRefresh.js");
+const { AntigravityExecutor } = await import("../../open-sse/executors/antigravity.js");
+const appRefresh = await import("../../src/sse/services/tokenRefresh.js");
+
+const log = { info() {}, warn() {}, error() {}, debug() {} };
+const TOK = "https://oauth2.googleapis.com/token";
+
+let tokenFetches, inFlight, maxInFlight, failMode;
+function installFetch(delayMs = 15) {
+  tokenFetches = 0; inFlight = 0; maxInFlight = 0;
+  globalThis.fetch = async (url) => {
+    if (String(url).includes("oauth2.googleapis.com")) {
+      tokenFetches++; inFlight++; maxInFlight = Math.max(maxInFlight, inFlight);
+      await new Promise(r => setTimeout(r, delayMs));
+      inFlight--;
+      if (failMode) return new Response("boom", { status: 500 });
+      return Response.json({ access_token: `fresh-${Date.now()}`, expires_in: 3600, refresh_token: "rotated-rt" });
+    }
+    throw new Error(`Unexpected offline fetch: ${url}`);
+  };
+}
+
+async function account(name) {
+  return repo.createProviderConnection({ provider: "antigravity", authType: "oauth", name,
+    email: `${name}@example.invalid`, accessToken: "old", refreshToken: `rt-${name}`,
+    expiresAt: new Date(Date.now() + 3600000).toISOString(), isActive: true });
+}
+const credsFor = c => ({ ...c, connectionId: c.id, provider: "antigravity" });
+
+describe("AG P1-3 refresh singleflight across all entry points (offline)", () => {
+  beforeEach(async () => {
+    resetQuarantineMemory();
+    repo.registerQuarantinePersistenceHandler();
+    failMode = false;
+    installFetch();
+    for (const c of await repo.getProviderConnections()) await repo.deleteProviderConnection(c.id);
+    await updateSettings({ requireApiKey: false });
+  });
+  afterEach(() => resetQuarantineMemory());
+
+  it("concurrent refreshes through every AG entry point share ONE token HTTP call", async () => {
+    const conn = await account("shared");
+    const creds = credsFor(conn);
+    const executor = new AntigravityExecutor();
+    const jobs = [];
+    for (let i = 0; i < 5; i++) jobs.push(ocm.refreshProviderCredentials("antigravity", { ...creds }));
+    for (let i = 0; i < 5; i++) jobs.push(executor.refreshCredentials({ ...creds }, log));
+    for (let i = 0; i < 5; i++) jobs.push(tr.getAccessToken("antigravity", { ...creds, refreshToken: conn.refreshToken }, log));
+    for (let i = 0; i < 5; i++) jobs.push(appRefresh.checkAndRefreshToken("antigravity", { ...creds }, { force: true }));
+    const settled = await Promise.race([
+      Promise.allSettled(jobs),
+      new Promise((_, rej) => setTimeout(() => rej(new Error("deadlock: concurrent refreshes never settle")), 5000)),
+    ]).catch(e => { assert.fail(e.message); });
+    assert.ok(settled.every(s => s.status === "fulfilled"), "every entry point settles without deadlock");
+    assert.equal(tokenFetches, 1, `20 concurrent refreshes must collapse to 1 token HTTP, got ${tokenFetches}`);
+  });
+
+  it("different credentials refresh independently and in parallel", async () => {
+    const c1 = await account("par-1");
+    const c2 = await account("par-2");
+    const [t1, t2] = await Promise.all([
+      ocm.refreshProviderCredentials("antigravity", credsFor(c1)),
+      tr.getAccessToken("antigravity", { ...credsFor(c2), refreshToken: c2.refreshToken }, log),
+    ]);
+    assert.ok(t1 && t2, "both refreshes produce results");
+    assert.equal(tokenFetches, 2, "distinct identities get their own token HTTP");
+    assert.ok(maxInFlight >= 2, "distinct identities are not serialized behind one lock");
+  });
+
+  it("failed refresh releases the lock so a later refresh can proceed", async () => {
+    const conn = await account("retry");
+    const creds = credsFor(conn);
+    failMode = true;
+    const first = await ocm.refreshProviderCredentials("antigravity", { ...creds });
+    assert.equal(first, null, "failed refresh resolves to null");
+    assert.equal(tokenFetches, 1);
+    failMode = false;
+    const second = await ocm.refreshProviderCredentials("antigravity", { ...creds });
+    assert.ok(second?.accessToken, "retry after failure succeeds (lock not leaked)");
+    assert.equal(tokenFetches, 2);
+  });
+
+  it("quarantined account: mixed concurrent entry points produce ZERO token HTTP", async () => {
+    const conn = await account("banned");
+    await persistQuarantine(conn.id, "TOS_VIOLATION", log);
+    const creds = credsFor(conn);
+    const executor = new AntigravityExecutor();
+    await Promise.all([
+      ocm.refreshProviderCredentials("antigravity", { ...creds }),
+      executor.refreshCredentials({ ...creds }, log),
+      tr.getAccessToken("antigravity", { ...creds, refreshToken: conn.refreshToken }, log),
+      appRefresh.checkAndRefreshToken("antigravity", { ...creds }, { force: true }),
+    ]);
+    assert.equal(tokenFetches, 0, "quarantine blocks every refresh entry point");
+  });
+});
diff --git a/tests/unit/antigravity-retry-budget.test.js b/tests/unit/antigravity-retry-budget.test.js
