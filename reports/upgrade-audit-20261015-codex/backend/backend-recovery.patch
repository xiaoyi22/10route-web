+    mocks.getChannelBalances.mockResolvedValue({ channels: [], channelOptions: [] });
+    const { GET } = await import("../../src/app/api/channel-balances/route.js");
+    const response = await GET(new Request("http://localhost/api/channel-balances?preferences=1"));
+    expect(response.status).toBe(200); expect(mocks.getChannelBalances).toHaveBeenCalledWith({ query: false });
+  });
+
+  it("saves a single channel toggle and returns metadata without balance requests", async () => {
+    mocks.getChannelBalances.mockResolvedValue({ channels: [], channelOptions: [{ id: "one", enabled: true }] });
+    const { PATCH } = await import("../../src/app/api/channel-balances/route.js");
+    const response = await PATCH(new Request("http://localhost/api/channel-balances", { method: "PATCH", body: JSON.stringify({ channelId: "one", enabled: false }) }));
+    expect(response.status).toBe(200); expect(response.headers.get("Cache-Control")).toBe("private, no-store");
+    expect(mocks.setChannelBalanceEnabled).toHaveBeenCalledWith("one", false);
+    expect(mocks.getChannelBalances.mock.calls.every(([options]) => options.query === false)).toBe(true);
+    expect(await response.json()).not.toHaveProperty("settings");
+  });
+
+  it("rejects malformed bodies, invalid types and settings mass assignment", async () => {
+    const { PATCH } = await import("../../src/app/api/channel-balances/route.js");
+    for (const body of ["{", "null", "[]", JSON.stringify({ channelId: "one", enabled: "false" }), JSON.stringify({ channelId: "one", enabled: false, requireLogin: false }), JSON.stringify({ channelId: "", enabled: false })]) {
+      const response = await PATCH(new Request("http://localhost/api/channel-balances", { method: "PATCH", body }));
+      expect(response.status).toBe(400);
+    }
+    expect(mocks.setChannelBalanceEnabled).not.toHaveBeenCalled();
