+        const res = success();
+        if (m === "other/one") res.clone = () => ({ json: async () => { parsing(); await jsonReady; return { choices: [{ message: { content: "one" } }] }; } });
+        return res;
+      } });
+    await parsingStarted;
+    completeTos(stopped);
+    await new Promise(resolve => setImmediate(resolve));
+    finishJson();
+    assert.equal(await pending, stopped);
+    assert.deepEqual(calls, ["other/one", "other/two", "ag/late"]);
+  });
+
+  it("R1 preserves healthy fusion judge scheduling", async () => {
+    const calls = [];
+    const result = await handleFusionChat({ body, models: ["other/one", "other/two"], judgeModel: "ag/judge", log,
+      handleSingleModel: async (_body, m) => { calls.push(m); return success(); } });
+    assert.equal(result.status, 200);
+    assert.deepEqual(calls, ["other/one", "other/two", "ag/judge"]);
