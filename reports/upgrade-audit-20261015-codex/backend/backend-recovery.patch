+          </section>
+        ))}
+      </div>
+
+      {channel.subscriptions?.length > 0 && (
+        <section className="space-y-3 border-t border-border pt-3" aria-label={translate("Channel subscriptions")}>
+          <h3 className="text-sm font-semibold text-text-main">{translate("Channel subscriptions")}</h3>
+          {channel.subscriptions.map((subscription, index) => (
+            <div key={subscription.id || index} className="space-y-2">
+              <div className="flex flex-wrap items-center justify-between gap-2 text-xs">
+                <span className="font-medium text-text-main">{subscription.name || translate("Subscription")}</span>
