+
+  it("R2 AG quota transport does not fall back after concurrent quarantine", async () => {
+    const conn = await account("transport-race");
+    const attempts = [];
+    mockFetch = async (_url, options) => {
+      attempts.push({ proxy: !!options.dispatcher, blocked: isConnectionQuarantined(conn.id) });
+      if (attempts.length === 1) {
