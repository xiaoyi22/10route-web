+import { createHash } from "node:crypto";
+import { getProviderConnections, getProviderNodes, getSettings } from "@/lib/localDb";
+import { resolveConnectionProxyConfig } from "@/lib/network/connectionProxy";
+import { proxyAwareFetch } from "open-sse/utils/proxyFetch.js";
+
+const CACHE_TTL_MS = 5 * 60 * 1000;
+const FORCE_MIN_INTERVAL_MS = 30 * 1000;
+const cache = new Map();
+const inflight = new Map();
+const periods = ["hourly", "daily", "weekly", "monthly"];
+const fundingSources = new Set(["balance", "subscription", "subscription_then_balance", "balance_then_subscription", "none"]);
+const publicAdapters = {
+  "api.bxacc.xyz": "newapi", "pmcat.top": "newapi", "api.feixingwawa.cn": "newapi", "grok-heavy.878.indevs.in": "newapi",
+  "x-api.cfd": "sub2api", "api.xn--xwr.site": "sub2api", "api.fengwind.com": "fengwind", "anyrouter.top": "legacy",
+};
+const numberOrNull = (value) => typeof value === "number" && Number.isFinite(value) ? value : null;
+const safeText = (value) => typeof value === "string" ? value.replace(/sk-[\w-]+/g, "[redacted]").slice(0, 160) : null;
+const dateOrNull = (value) => typeof value === "string" && Number.isFinite(Date.parse(value)) ? value : null;
+
+export function getChannelBalanceAdapter(node) {
+  if (!["openai-compatible", "anthropic-compatible"].includes(node?.type)) return null;
+  try {
+    const url = new URL(node.baseUrl);
+    if (url.protocol !== "https:" || url.port || url.username || url.password || url.search || url.hash || !["", "/", "/v1", "/v1/"].includes(url.pathname)) return null;
+    if (["nexavlinks.com", "www.nexavlinks.com"].includes(url.hostname)) return "nexavlinks";
+    if (url.hostname === "aiapi.codes") return "aiapi";
+    if (url.hostname === "relayfor.xyz") return "relayfor";
+    return Object.hasOwn(publicAdapters, url.hostname) ? publicAdapters[url.hostname] : null;
+  } catch {
+    return null;
+  }
+  return null;
+}
+
+function emptyBalance() {
+  return { wallet: null, available: null, subscriptions: [], limits: [], today: null, keyQuota: null, keyExpiresAt: null, channelFunding: [], notice: null };
+}
+
+export function parseNexaBalance(usage, subscriptions) {
+  if (usage !== null && (!usage || usage.isValid !== true || usage.unit !== "USD")) throw new Error("Invalid balance response");
+  if (subscriptions !== null && (!subscriptions || subscriptions.object !== "list" || !Array.isArray(subscriptions.data))) throw new Error("Invalid subscription response");
+  const result = emptyBalance();
+  if (usage) {
+    const balance = numberOrNull(usage.balance);
+    if (balance !== null) result.wallet = { amount: balance, currency: "USD" };
+    const remaining = numberOrNull(usage.remaining);
+    if (remaining !== null) result.available = { amount: remaining, currency: "USD", source: balance !== null ? "balance" : usage.subscription ? "subscription" : "unknown" };
+    if (usage.usage?.today) result.today = { currency: "USD", cost: numberOrNull(usage.usage.today.cost), calls: numberOrNull(usage.usage.today.calls), tokens: numberOrNull(usage.usage.today.tokens) };
+  }
+  for (const entry of subscriptions?.data || []) {
+    if (!entry?.subscription || typeof entry.subscription !== "object") continue;
+    const subscription = entry.subscription;
+    const identifier = typeof subscription.id === "string" || typeof subscription.id === "number" ? String(subscription.id).slice(0, 80) : null;
+    result.subscriptions.push({
+      id: identifier,
+      name: safeText(subscription.plan_name),
+      expiresAt: dateOrNull(subscription.expires_at),
+      windows: periods.filter((period) => entry.progress?.[period] && typeof entry.progress[period] === "object").map((period) => {
+        const window = entry.progress[period];
+        return { period, currency: "USD", limit: numberOrNull(window.limit_usd), used: numberOrNull(window.used_usd), remaining: numberOrNull(window.remaining_usd), resetsAt: dateOrNull(window.resets_at) };
+      }),
+    });
+  }
+  return result;
+}
+
+export function parseAiapiBalance(payload) {
+  const data = payload?.data;
+  if (payload?.ok !== true || !data || !/^[A-Z]{3}$/.test(data.currency || "") || !data.available || typeof data.available !== "object") throw new Error("Invalid balance response");
+  const source = fundingSources.has(data.available.source) ? data.available.source : "unknown";
+  return {
+    ...emptyBalance(),
+    walletUnavailable: true,
+    balanceUrl: "https://aiapi.codes/dashboard",
+    notice: "Wallet balance requires website login; this API returns key credit only",
+    available: { amount: numberOrNull(data.available.amount), currency: data.currency, source },
+    limits: periods.filter((period) => numberOrNull(data.limits?.[period]?.limit) !== null).map((period) => {
+      const window = data.limits[period];
+      return { period, currency: data.currency, limit: numberOrNull(window.limit), used: numberOrNull(window.used), remaining: numberOrNull(window.remaining), resetsAt: dateOrNull(window.resetsAt || window.resetAt) };
+    }),
+    today: data.today ? { currency: data.currency, cost: numberOrNull(data.today.cost), calls: numberOrNull(data.today.calls), tokens: numberOrNull(data.today.tokens) } : null,
+  };
+}
+
+export function parseNewapiBalance(payload) {
+  const data = payload?.data;
+  if (!(payload?.code === true || payload?.success === true) || !data || data.object !== "token_usage" || typeof data.unlimited_quota !== "boolean") throw new Error("Invalid balance response");
+  const expiry = numberOrNull(data.expires_at);
+  return {
+    ...emptyBalance(),
+    keyQuota: {
+      unit: "quota", unlimited: data.unlimited_quota,
+      limit: data.unlimited_quota ? null : numberOrNull(data.total_granted),
+      used: numberOrNull(data.total_used),
+      remaining: data.unlimited_quota ? null : numberOrNull(data.total_available),
+    },
+    keyExpiresAt: expiry !== null && expiry > 0 && expiry <= 8640000000000 ? new Date(expiry * 1000).toISOString() : null,
+    notice: "Key quota is not wallet balance; site-level limits may still apply",
+  };
+}
+
+function normalizeFundingWindow(window) {
+  const period = { "5h": "rolling5h", "1d": "daily", "7d": "weekly", "30d": "monthly" }[window?.window];
+  return period ? { period, currency: "USD", limit: numberOrNull(window.limit), used: numberOrNull(window.used), remaining: numberOrNull(window.remaining), resetsAt: dateOrNull(window.reset_at) } : null;
+}
+
+export function parseFengwindBalance(payload) {
+  if (payload?.isValid === true) return parseNexaBalance(payload, null);
+  if (payload?.object !== "sub2api.key_usage" || payload.schema_version !== 1 || payload.wallet?.unit !== "USD" || numberOrNull(payload.wallet.balance) === null || !["active", "expired", "quota_exhausted"].includes(payload.key?.status) || !Array.isArray(payload.key.rate_limits) || !Array.isArray(payload.channels)) throw new Error("Invalid balance response");
+  const quota = payload.key.quota;
+  const today = payload.usage?.today;
+  return {
+    ...emptyBalance(),
+    wallet: { amount: payload.wallet.balance, currency: "USD" },
+    limits: [
+      ...(quota?.unit === "USD" ? [{ period: "total", currency: "USD", limit: numberOrNull(quota.limit), used: numberOrNull(quota.used), remaining: numberOrNull(quota.remaining), resetsAt: null }] : []),
+      ...payload.key.rate_limits.map(normalizeFundingWindow).filter(Boolean),
+    ],
+    keyExpiresAt: dateOrNull(payload.key.expires_at),
+    channelFunding: payload.channels.filter(channel => channel && Number.isSafeInteger(channel.channel_id) && ["available", "unavailable"].includes(channel.status)).map(channel => ({
+      id: String(channel.channel_id), name: safeText(channel.name), status: channel.status,
+      source: channel.status === "available" && ["balance", "subscription"].includes(channel.funding) ? channel.funding : "unknown",
+      expiresAt: dateOrNull(channel.subscription?.expires_at),
+      windows: channel.status === "available" && Array.isArray(channel.windows) ? channel.windows.map(normalizeFundingWindow).filter(Boolean) : [],
+    })),
+    today: today ? { currency: "USD", cost: numberOrNull(today.actual_cost), calls: numberOrNull(today.requests), tokens: numberOrNull(today.total_tokens) } : null,
+    notice: "Wallet, key limits and upstream channel limits are separate; do not add them together",
+  };
+}
+
+async function queryJson(origin, path, connection, proxyOptions) {
+  let response;
+  try {
+    response = await proxyAwareFetch(origin + path, {
+      method: "GET",
+      redirect: "manual",
+      headers: { Authorization: `Bearer ${connection.apiKey}`, Accept: "application/json", "Cache-Control": "no-cache", "User-Agent": "10router-balance/1.0" },
+      signal: AbortSignal.timeout(15_000),
+    }, proxyOptions);
+  } catch (error) {
+    throw new Error(error?.name === "TimeoutError" || error?.name === "AbortError" ? "Balance query timed out" : "Network error querying balance");
+  }
+  let payload;
+  try {
+    payload = await response.json();
+  } catch {
+    if (!response.ok) throw new Error(`Balance query returned HTTP ${response.status}`);
+    throw new Error("Invalid balance response");
+  }
+  if (!response.ok) {
+    if (response.status === 403 && path === "/v1/subscriptions" && payload?.error?.type === "SUBSCRIPTION_QUERY_DISABLED") throw new Error("API Key subscription queries are disabled in NexaVlinks personal settings.");
+    throw new Error(`Balance query returned HTTP ${response.status}`);
+  }
+  return payload;
+}
+
+async function queryBalance(connection, node, adapter, proxyOptions) {
+  const origin = new URL(node.baseUrl).origin;
+  if (adapter === "aiapi") return { ...parseAiapiBalance(await queryJson(origin, "/v1/usage", connection, proxyOptions)), status: "ok", error: null };
+  if (adapter === "newapi") return { ...parseNewapiBalance(await queryJson(origin, "/api/usage/token/", connection, proxyOptions)), status: "ok", error: null };
+  if (adapter === "sub2api") return { ...parseNexaBalance(await queryJson(origin, "/v1/usage", connection, proxyOptions), null), status: "ok", error: null };
+  if (adapter === "fengwind") return { ...parseFengwindBalance(await queryJson(origin, "/v1/usage?days=7", connection, proxyOptions)), status: "ok", error: null };
+  if (adapter === "legacy") {
+    const payload = await queryJson(origin, "/v1/dashboard/billing/subscription", connection, proxyOptions);
+    if (payload?.object !== "billing_subscription" || numberOrNull(payload.hard_limit_usd) === null) throw new Error("Invalid balance response");
+    return { ...emptyBalance(), status: "unverified", error: null, notice: "Legacy billing limits do not confirm actual balance" };
+  }
+  const queries = await Promise.allSettled([
+    queryJson(origin, "/v1/usage?days=7", connection, proxyOptions).then((payload) => { parseNexaBalance(payload, null); return payload; }),
+    queryJson(origin, "/v1/subscriptions", connection, proxyOptions).then((payload) => { parseNexaBalance(null, payload); return payload; }),
+  ]);
+  const usage = queries[0].status === "fulfilled" ? queries[0].value : null;
+  const subscriptions = queries[1].status === "fulfilled" ? queries[1].value : null;
+  const errors = queries.filter((query) => query.status === "rejected").map((query) => query.reason.message);
+  return { ...parseNexaBalance(usage, subscriptions), status: errors.length === 2 ? "error" : errors.length ? "partial" : "ok", error: errors.length ? [...new Set(errors)].join("; ") : null };
+}
+
+async function connectionBalance(connection, node, adapter, force) {
+  const base = { id: connection.id, name: safeText(connection.name) || "Unnamed connection", isActive: connection.isActive !== false };
+  if (!base.isActive) return { ...base, ...emptyBalance(), status: "disabled", checkedAt: null, error: null, cached: false };
+  if (adapter === "unsupported") return { ...base, ...emptyBalance(), status: "unsupported", checkedAt: null, error: null, cached: false, notice: "Balance queries are not yet supported for this channel" };
+  if (adapter === "relayfor") return {
+    ...base, ...emptyBalance(), status: "login_required", checkedAt: null, error: null, cached: false,
+    walletUnavailable: true, balanceUrl: "https://relayfor.xyz/console/",
+    notice: "RelayFor account balance requires website login; no API-key balance endpoint has been verified",
+  };
+  if (typeof connection.apiKey !== "string" || !connection.apiKey) return { ...base, ...emptyBalance(), status: "error", checkedAt: null, error: "API key is not configured", cached: false };
+  const proxyOptions = await resolveConnectionProxyConfig(connection.providerSpecificData);
+  const cacheKey = createHash("sha256").update(JSON.stringify([adapter, connection.id, node.baseUrl, connection.apiKey, proxyOptions])).digest("hex");
+  const hit = cache.get(cacheKey);
+  if (hit && Date.now() - hit.at < (force ? FORCE_MIN_INTERVAL_MS : CACHE_TTL_MS)) return { ...base, ...hit.value, cached: true };
+  let pending = inflight.get(cacheKey);
+  if (!pending) {
+    pending = queryBalance(connection, node, adapter, proxyOptions)
+      .catch((error) => ({ ...emptyBalance(), status: "error", error: error.message }))
+      .then((value) => {
+        const checkedAt = new Date().toISOString();
+        const snapshot = !hasBalanceData(value) && hit && hasBalanceData(hit.value)
+          ? { ...hit.value, status: "partial", stale: true, error: value.error || "Invalid balance response", lastAttemptAt: checkedAt }
+          : { ...value, checkedAt };
+        if (cache.size >= 200) cache.delete(cache.keys().next().value);
+        cache.set(cacheKey, { at: Date.now(), value: snapshot });
+        return snapshot;
+      })
+      .finally(() => inflight.delete(cacheKey));
+    inflight.set(cacheKey, pending);
+  }
+  return { ...base, ...await pending, cached: false };
+}
+
+function hasBalanceData(connection) {
+  if (!["ok", "partial"].includes(connection.status)) return false;
+  const hasAmount = (amount) => numberOrNull(amount) !== null;
+  return hasAmount(connection.wallet?.amount) || hasAmount(connection.available?.amount)
+    || connection.keyQuota?.unlimited === true || hasAmount(connection.keyQuota?.remaining)
+    || connection.subscriptions.some(subscription => subscription.windows.some(window => hasAmount(window.remaining)))
+    || connection.limits.some(window => hasAmount(window.remaining))
+    || connection.channelFunding.some(funding => funding.status === "available" && funding.windows.some(window => hasAmount(window.remaining)));
+}
+
+export async function getChannelBalances({ force = false, query = true } = {}) {
+  const [nodes, connections, settings] = await Promise.all([getProviderNodes(), getProviderConnections(), getSettings()]);
+  const disabled = new Set(Array.isArray(settings.channelBalanceDisabledIds) ? settings.channelBalanceDisabledIds : []);
+  const configured = nodes.filter(node => ["openai-compatible", "anthropic-compatible"].includes(node.type)).map(node => ({ node, adapter: getChannelBalanceAdapter(node) || "unsupported" })).map(({ node, adapter }) => ({
+    id: node.id, name: adapter === "sub2api" && node.name === "XWR" ? "哲のAPI（XWR）" : safeText(node.name) || adapter, prefix: safeText(node.prefix), adapter,
+    category: ["publicWelfare", "relay"].includes(node.category) ? node.category : "other",
+    connections: connections.filter((connection) => connection.provider === node.id && ["apikey", "api_key"].includes(connection.authType)),
+  })).filter((channel) => channel.connections.length);
+  const channelOptions = configured.map(channel => ({ id: channel.id, name: channel.name, prefix: channel.prefix, enabled: !disabled.has(channel.id), connectionCount: channel.connections.length }));
+  if (!query) return { generatedAt: new Date().toISOString(), channels: [], channelOptions, errors: [] };
+  const channels = configured.filter(channel => !disabled.has(channel.id));
+  const nodeMap = new Map(nodes.map((node) => [node.id, node]));
+  const work = channels.flatMap((channel) => channel.connections.map((connection, index) => ({ channel, connection, index })));
+  let next = 0;
+  await Promise.all(Array.from({ length: Math.min(4, work.length) }, async () => {
+    while (next < work.length) {
+      const entry = work[next++];
+      entry.channel.connections[entry.index] = await connectionBalance(entry.connection, nodeMap.get(entry.channel.id), entry.channel.adapter, force);
+    }
+  }));
+  const errors = [];
+  for (const channel of channels) {
+    for (const connection of channel.connections) {
+      if (connection.error) errors.push({ channelId: channel.id, channelName: channel.name, connectionId: connection.id, connectionName: connection.name, error: connection.error });
+    }
+    channel.connections = channel.connections.filter(connection => hasBalanceData(connection) || connection.status === "login_required");
+    const shared = new Map();
+    for (const connection of channel.connections) {
+      for (const [index, subscription] of connection.subscriptions.entries()) {
+        const identifier = subscription.id || `${connection.id}:${index}`;
+        const existing = shared.get(identifier);
+        if (existing) existing.connectionIds.push(connection.id);
+        else shared.set(identifier, { ...subscription, connectionIds: [connection.id] });
+      }
+      delete connection.subscriptions;
+    }
+    channel.subscriptions = [...shared.values()];
+  }
+  return { generatedAt: new Date().toISOString(), channels: channels.filter(channel => channel.connections.length), channelOptions, errors };
+}
