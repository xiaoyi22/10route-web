+      const models = ["ag/banned", "ag/healthy", "other/panel"];
+      const calls = [];
+      const response = await handleFusionChat({ body, models, judgeModel: "ag/judge", log,
+        handleSingleModel: async (_body, m) => {
+          calls.push(m);
+          if (m === models[0]) return stopped;
+          return models.indexOf(m) <= successfulPanels ? success() : new Response("failed", { status: 500 });
+        } });
+      assert.deepEqual(calls, models, "No judge/replay may be newly scheduled after TOS");
+      assert.equal(response, stopped, "Preserve the TOS stop for outer combos/account loops");
+    });
+  }
+
+  it("R1 retains a TOS arriving after quorum while panel JSON is being consumed", async () => {
+    let completeTos;
+    let parsing;
+    const parsingStarted = new Promise(resolve => { parsing = resolve; });
+    let finishJson;
+    const jsonReady = new Promise(resolve => { finishJson = resolve; });
+    const stopped = tos();
+    stopped.isTosQuarantined = true;
+    const calls = [];
+    const pending = handleFusionChat({ body, models: ["other/one", "other/two", "ag/late"], judgeModel: "ag/judge", log,
+      tuning: { minPanel: 2, stragglerGraceMs: 1, panelHardTimeoutMs: 1000 },
+      handleSingleModel: async (_body, m) => {
+        calls.push(m);
